# ============================================================
# Drilling Data Visualization — configuración
# Copiar a .env y completar los valores marcados.
# ============================================================

APP_NAME=Drilling Analysis API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Base de datos (Supabase, esquema ddv) ------------------
# Dashboard -> Connect -> Direct connection. Completar la contraseña.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.zbaoskblwtnfrownumbv.supabase.co:5432/postgres
DB_SCHEMA=ddv

# --- Supabase Auth ------------------------------------------
# La clave publicable es segura de exponer: no autoriza por sí sola.
SUPABASE_URL=https://zbaoskblwtnfrownumbv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_i69xYL4V6e_m-tTCaTSfig_LsjqlWxb

# Clave de servicio, necesaria SOLO para administrar cuentas desde el servidor.
# Salta las políticas RLS y da acceso total a la base: no debe salir del
# servidor ni entrar al repositorio. Se obtiene en Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesión --------------------------------------------------
# Clave para firmar cookies propias. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_ANTES_DE_PRODUCCION

# En desarrollo local sobre http hay que desactivarlo, o el navegador
# descarta las cookies de sesión.
COOKIE_SECURE=false

# --- Límites de consulta -------------------------------------
MAX_QUERY_LIMIT=100000
DEFAULT_QUERY_LIMIT=10000
