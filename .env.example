# Copia este archivo a .env y completa los valores para tu entorno local.
# app/core/config.py lee estas variables (todas tienen default salvo las marcadas como requeridas).

# --- App ---
APP_NAME=Drilling Analysis API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drilling_db

# --- Autenticación ---
# REQUERIDO en producción (ENVIRONMENT=production + DEBUG=False): la app rechaza
# arrancar si queda en el valor placeholder de app/core/config.py. Genera uno único,
# ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Límites de consulta sobre las tablas de sensores (well_data / well_data_time) ---
MAX_QUERY_LIMIT=100000
DEFAULT_QUERY_LIMIT=10000

# --- CORS ---
# Vacío por defecto: la app se sirve same-origin (Jinja2 + HTMX). Solo completar si
# algo externo necesita llamar a /api/v1/* desde otro origen, ej.: ["https://ejemplo.com"]
CORS_ORIGINS=[]

# --- Seed del usuario admin inicial (alembic/versions/20260404_seed_admin_user.py) ---
# Si ADMIN_SEED_PASSWORD no está definida, la migración se salta el seed (sin crear
# admin) en vez de usar una contraseña por defecto insegura.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
